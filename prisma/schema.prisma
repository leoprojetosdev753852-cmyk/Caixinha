// Schema do banco — Caixinha

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum TipoChavePix {
  CPF
  EMAIL
  TELEFONE
  ALEATORIA
}

enum StatusCaixinha {
  RASCUNHO
  ATIVA
  CONCLUIDA
  CANCELADA
}

enum StatusPagamentoCaixinha {
  PENDENTE
  PAGO
  ATRASADO
}

enum TipoEmprestimo {
  A_VISTA
  PARCELADO
}

enum StatusEmprestimo {
  ATIVO
  QUITADO
  ATRASADO
  CANCELADO
}

enum StatusParcelaEmprestimo {
  PENDENTE
  PAGO
  ATRASADO
}

enum TipoPagamentoEmprestimo {
  INTEGRAL
  SO_JUROS_RENOVOU
  PARCIAL
}

model Usuario {
  id             String  @id @default(cuid())
  nomeCompleto   String
  cpf            String? @unique
  username       String? @unique
  senhaHash      String?
  role           Role    @default(USER)
  perfilCompleto Boolean @default(false)
  ativo          Boolean @default(true)

  tipoChavePix TipoChavePix?
  chavePix     String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  criadoPorId     String?
  criadoPor       Usuario?  @relation("UsuariosCriados", fields: [criadoPorId], references: [id])
  usuariosCriados Usuario[] @relation("UsuariosCriados")

  cotas         CotaPonto[]
  emprestimos   Emprestimo[]
  refreshTokens RefreshToken[]
  auditorias    Auditoria[]

  @@index([cpf])
  @@index([username])
  @@map("usuarios")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  revogado  Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([token])
  @@index([usuarioId])
  @@map("refresh_tokens")
}

model Caixinha {
  id            String         @id @default(cuid())
  nome          String
  observacao    String?
  status        StatusCaixinha @default(RASCUNHO)
  dataAtivacao  DateTime?
  diaPagamento  Int

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pontos PontoCaixinha[]

  @@map("caixinhas")
}

model PontoCaixinha {
  id               String    @id @default(cuid())
  caixinhaId       String
  caixinha         Caixinha  @relation(fields: [caixinhaId], references: [id], onDelete: Cascade)
  numero           Int
  valor            Int
  dataContemplacao DateTime?

  cotas CotaPonto[]

  @@unique([caixinhaId, numero])
  @@map("pontos_caixinha")
}

model CotaPonto {
  id        String        @id @default(cuid())
  pontoId   String
  ponto     PontoCaixinha @relation(fields: [pontoId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario       @relation(fields: [usuarioId], references: [id])

  valor Int

  criadoEm DateTime @default(now())

  pagamentos PagamentoCota[]

  @@index([usuarioId])
  @@index([pontoId])
  @@map("cotas_ponto")
}

model PagamentoCota {
  id     String    @id @default(cuid())
  cotaId String
  cota   CotaPonto @relation(fields: [cotaId], references: [id], onDelete: Cascade)

  valorDevido    Int
  dataVencimento DateTime
  status         StatusPagamentoCaixinha @default(PENDENTE)
  dataPagamento  DateTime?
  observacao     String?

  baixadoPorId String?
  criadoEm     DateTime @default(now())

  @@index([cotaId])
  @@index([status])
  @@index([dataVencimento])
  @@map("pagamentos_cota")
}

model Emprestimo {
  id                    String           @id @default(cuid())

  nomeDevedor           String
  pixDevedor            String?
  observacao            String?

  usuarioId             String?
  usuario               Usuario?         @relation(fields: [usuarioId], references: [id])

  tipo                  TipoEmprestimo
  valorOriginal         Int
  percentualJuros       Decimal          @db.Decimal(5, 2)
  percentualJurosAtraso Decimal          @db.Decimal(5, 2)

  dataVencimento DateTime?
  valorPago      Int       @default(0)
  dataPagamento  DateTime?
  diasAtraso     Int       @default(0)

  status StatusEmprestimo @default(ATIVO)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  parcelas    ParcelaEmprestimo[]
  pagamentos  PagamentoEmprestimo[]

  @@index([usuarioId])
  @@index([status])
  @@map("emprestimos")
}

model ParcelaEmprestimo {
  id           String     @id @default(cuid())
  emprestimoId String
  emprestimo   Emprestimo @relation(fields: [emprestimoId], references: [id], onDelete: Cascade)

  numero         Int
  valorDevido    Int
  dataVencimento DateTime
  status         StatusParcelaEmprestimo @default(PENDENTE)
  valorPago      Int      @default(0)
  dataPagamento  DateTime?
  diasAtraso     Int      @default(0)

  baixadoPorId String?
  criadoEm     DateTime @default(now())

  @@unique([emprestimoId, numero])
  @@index([status])
  @@map("parcelas_emprestimo")
}

model PagamentoEmprestimo {
  id                  String                 @id @default(cuid())
  emprestimoId        String
  emprestimo          Emprestimo             @relation(fields: [emprestimoId], references: [id], onDelete: Cascade)

  valorPago           Int
  valorJuros          Int                    @default(0)
  valorCapital        Int                    @default(0)
  dataPagamento       DateTime
  tipo                TipoPagamentoEmprestimo
  observacao          String?
  novaDataVencimento  DateTime?

  registradoPorId     String?
  criadoEm            DateTime               @default(now())

  @@index([emprestimoId])
  @@index([dataPagamento])
  @@map("pagamentos_emprestimo")
}

model Auditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  categoria String
  acao      String
  metadata  Json?
  ip        String?
  userAgent String?

  criadoEm DateTime @default(now())

  @@index([categoria])
  @@index([usuarioId])
  @@index([criadoEm])
  @@map("auditorias")
}
