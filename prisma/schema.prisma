// Schema do banco — Caixinha
// Inclui Fases 1 (usuários) + 2 (caixinhas com pontos compartilhados) + 3 (empréstimos)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  USER
}

enum TipoChavePix {
  CPF
  EMAIL
  TELEFONE
  ALEATORIA
}

enum StatusCaixinha {
  RASCUNHO   // criada, admin configurando
  ATIVA      // ativada, pagamentos rolando
  CONCLUIDA  // todos pagamentos quitados
  CANCELADA  // encerrada manualmente
}

enum StatusPagamentoCaixinha {
  PENDENTE
  PAGO
  ATRASADO
}

enum TipoEmprestimo {
  A_VISTA     // parcela única (valor + juros, vence numa data)
  PARCELADO   // N parcelas mensais
}

enum StatusEmprestimo {
  ATIVO
  QUITADO
  ATRASADO
  CANCELADO
}

enum StatusParcelaEmprestimo {
  PENDENTE
  PAGO
  ATRASADO
}

// ============================================
// USUÁRIOS & AUTH
// ============================================

model Usuario {
  id             String  @id @default(cuid())
  nomeCompleto   String
  cpf            String  @unique
  senhaHash      String?
  role           Role    @default(USER)
  perfilCompleto Boolean @default(false)
  ativo          Boolean @default(true)

  tipoChavePix TipoChavePix?
  chavePix     String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  criadoPorId     String?
  criadoPor       Usuario?  @relation("UsuariosCriados", fields: [criadoPorId], references: [id])
  usuariosCriados Usuario[] @relation("UsuariosCriados")

  cotas         CotaPonto[]
  emprestimos   Emprestimo[]
  refreshTokens RefreshToken[]
  auditorias    Auditoria[]

  @@index([cpf])
  @@map("usuarios")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  revogado  Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([token])
  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ============================================
// CAIXINHAS (consórcio com pontos compartilhados)
// ============================================

model Caixinha {
  id               String         @id @default(cuid())
  nome             String
  observacao       String?
  status           StatusCaixinha @default(RASCUNHO)
  dataAtivacao     DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  pontos PontoCaixinha[]

  @@map("caixinhas")
}

model PontoCaixinha {
  id              String    @id @default(cuid())
  caixinhaId      String
  caixinha        Caixinha  @relation(fields: [caixinhaId], references: [id], onDelete: Cascade)
  numero          Int       // 1, 2, 3...
  valor           Int       // valor TOTAL do ponto em centavos (admin define)
  dataContemplacao DateTime? // quando esse ponto "recebe o bolão" (admin define)

  cotas CotaPonto[]

  @@unique([caixinhaId, numero])
  @@map("pontos_caixinha")
}

/**
 * Cota representa um usuário participando de um ponto.
 * Um ponto pode ter 1 ou N cotas (compartilhado).
 * Soma de cotas.valor deve = ponto.valor
 */
model CotaPonto {
  id        String        @id @default(cuid())
  pontoId   String
  ponto     PontoCaixinha @relation(fields: [pontoId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario       @relation(fields: [usuarioId], references: [id])

  valor Int  // valor da cota em centavos (admin define manualmente)

  criadoEm DateTime @default(now())

  pagamentos PagamentoCota[]

  @@index([usuarioId])
  @@index([pontoId])
  @@map("cotas_ponto")
}

/**
 * Pagamento mensal de uma cota.
 * Quando admin ativa a caixinha, gera 1 pagamento por (cota × mês de duração).
 */
model PagamentoCota {
  id     String    @id @default(cuid())
  cotaId String
  cota   CotaPonto @relation(fields: [cotaId], references: [id], onDelete: Cascade)

  valorDevido    Int
  dataVencimento DateTime
  status         StatusPagamentoCaixinha @default(PENDENTE)
  dataPagamento  DateTime?
  observacao     String?

  baixadoPorId String?
  criadoEm     DateTime @default(now())

  @@index([cotaId])
  @@index([status])
  @@index([dataVencimento])
  @@map("pagamentos_cota")
}

// ============================================
// EMPRÉSTIMOS (à vista ou parcelados)
// ============================================

model Emprestimo {
  id                    String           @id @default(cuid())
  usuarioId             String
  usuario               Usuario          @relation(fields: [usuarioId], references: [id])
  tipo                  TipoEmprestimo
  valorOriginal         Int              // valor emprestado em centavos
  percentualJuros       Decimal          @db.Decimal(5, 2)
  percentualJurosAtraso Decimal          @db.Decimal(5, 2)
  observacao            String?

  // Para A_VISTA
  dataVencimento DateTime?
  valorPago      Int       @default(0)
  dataPagamento  DateTime?
  diasAtraso     Int       @default(0)

  status StatusEmprestimo @default(ATIVO)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  parcelas ParcelaEmprestimo[]

  @@index([usuarioId])
  @@index([status])
  @@map("emprestimos")
}

/**
 * Parcelas de empréstimo PARCELADO.
 * Admin define data de vencimento e valor de cada parcela manualmente.
 */
model ParcelaEmprestimo {
  id           String     @id @default(cuid())
  emprestimoId String
  emprestimo   Emprestimo @relation(fields: [emprestimoId], references: [id], onDelete: Cascade)

  numero         Int
  valorDevido    Int
  dataVencimento DateTime
  status         StatusParcelaEmprestimo @default(PENDENTE)
  valorPago      Int      @default(0)
  dataPagamento  DateTime?
  diasAtraso     Int      @default(0)

  baixadoPorId String?
  criadoEm     DateTime @default(now())

  @@unique([emprestimoId, numero])
  @@index([status])
  @@map("parcelas_emprestimo")
}

// ============================================
// AUDITORIA
// ============================================

model Auditoria {
  id        String   @id @default(cuid())
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  categoria String
  acao      String
  metadata  Json?
  ip        String?
  userAgent String?

  criadoEm DateTime @default(now())

  @@index([categoria])
  @@index([usuarioId])
  @@index([criadoEm])
  @@map("auditorias")
}
