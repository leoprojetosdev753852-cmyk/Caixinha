# ==========================================
# Database (Railway PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/caixinhas"

# ==========================================
# Backend (apps/api)
# ==========================================
NODE_ENV="development"
PORT=3333

# JWT — gerar com: openssl rand -hex 32
JWT_ACCESS_SECRET="troque-este-valor-em-producao-32bytes-hex"
JWT_REFRESH_SECRET="troque-este-valor-tambem-32bytes-hex"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Cookies
COOKIE_DOMAIN="localhost"
COOKIE_SECURE="false"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Admin inicial (criado pelo seed)
ADMIN_INITIAL_NAME="Administrador"
ADMIN_INITIAL_CPF="00000000000"
ADMIN_INITIAL_PASSWORD="Trocar123Senha"

# ==========================================
# Frontend (apps/web)
# ==========================================
NEXT_PUBLIC_API_URL="http://localhost:3333"
