# ===========================================
# Banco de dados (Supabase)
# ===========================================
# Pegue em Supabase → Project Settings → Database → Connection string
# Use a "Pooler" (porta 6543) — funciona melhor com Vercel Serverless
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Use a "Direct" (porta 5432) — usada só pelo Prisma migrate
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ===========================================
# JWT
# ===========================================
# Gerar com: openssl rand -hex 32
# (ou no PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) }))
JWT_ACCESS_SECRET="cole-aqui-32+-caracteres-hex"
JWT_REFRESH_SECRET="outro-32+-caracteres-hex-diferente"

# ===========================================
# Cron (proteção do endpoint do worker)
# ===========================================
# Gerar com mesmo método acima
CRON_SECRET="outro-32-caracteres-hex"

# ===========================================
# Admin inicial (seed)
# ===========================================
ADMIN_INITIAL_NAME="Administrador"
ADMIN_INITIAL_CPF="00000000000"
ADMIN_INITIAL_PASSWORD="Trocar123Senha"
